# ── CureBlend Backend Environment Configuration Template ──
PORT=8000
DEBUG=false

# ── MongoDB Connection (Local or MongoDB Atlas) ──
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=cureblend
MONGODB_COLLECTION_HISTORY=assessment_history

# ── Allowed CORS Origins (Comma-separated or *) ──
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://your-frontend.vercel.app

# ── Inference Parameters ──
TOP_K_PREDICTIONS=5
TOP_K_FEATURES=10
