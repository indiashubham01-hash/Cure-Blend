# ==========================================
# CureBlend Backend Environment Configuration
# ==========================================

# ── MongoDB Connection ──
# For MongoDB Atlas:
# MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/?retryWrites=true&w=majority
#
# For Local MongoDB:
# MONGODB_URL=mongodb://localhost:27017

MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=cureblend
MONGODB_COLLECTION_HISTORY=assessment_history

# ── Application Settings ──
DEBUG=false
TOP_K_PREDICTIONS=5
TOP_K_FEATURES=10

# ── CORS Allowed Origins ──
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:5500
